# Copy to .env and fill in. These are public client values (they ship inside the app),
# but .env itself is kept out of git. Never put the Supabase secret / service_role key
# or the database password here.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Google Cloud → Credentials → OAuth 2.0 Client IDs → the *Web* client ID (see docs/supabase-setup.md)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=...apps.googleusercontent.com
