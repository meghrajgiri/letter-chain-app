{
  "name": "word-search",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-native-vector-icons/material-icons": "^13.1.4",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~57.0.27",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-google-mobile-ads": "^17.2.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "esbuild": "~0.28.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "report": "tsx scripts/puzzleReport.ts",
    "dailies": "tsx scripts/publishDailies.ts",
    "telegram:setup": "tsx scripts/setupTelegram.ts",
    "build:edge": "esbuild src/features/daily/trends/edge.ts --bundle --format=esm --platform=neutral --target=es2022 --legal-comments=none --banner:js=\"// Generated by npm run build:edge from src/features/daily. Do not edit.\" --outfile=supabase/functions/publish-daily/pipeline.js",
    "lint": "expo lint",
    "icons": "tsx scripts/generateIcons.ts",
    "audio": "tsx scripts/generateAudio.ts",
    "build:android": "sh scripts/buildLocal.sh production",
    "build:android:apk": "sh scripts/buildLocal.sh preview"
  },
  "private": true,
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "strict": true,
            "esModuleInterop": true,
            "module": "commonjs",
            "target": "es2020",
            "isolatedModules": true,
            "rootDir": "./"
          },
          "diagnostics": {
            "ignoreCodes": [
              "TS151001"
            ]
          }
        }
      ]
    }
  }
}
